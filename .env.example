# Copy to .env and adjust. Do not commit .env.

JUDGMENT_INGEST_USER_AGENT=ContractScanBot/0.1 (+https://github.com/siusiusiublack/contract_scan_backend)
# Fallback interval for sources without a dedicated setting
JUDGMENT_INGEST_RATE_LIMIT_SECONDS=1.0
# Per-source polite intervals (seconds between requests)
JUDGMENT_INGEST_FCL_RATE_LIMIT_SECONDS=1.0
# Conservative default for future BAILII HTML ingest — observe 429s, do not probe
JUDGMENT_INGEST_BAILII_RATE_LIMIT_SECONDS=3.0
# SQLite under EL-T stage 3
JUDGMENT_INGEST_DATABASE_URL=sqlite:///data/3_db/judgment_ingest.sqlite
JUDGMENT_INGEST_DATA_DIR=data
# Registered adapters that --source all will run (comma-separated). Grow over time.
JUDGMENT_INGEST_ENABLED_SOURCES=fcl
# Housing-focused default queries (comma-separated)
JUDGMENT_INGEST_DEFAULT_QUERIES=tenancy deposit,possession landlord,Housing Act tenancy
